# Secrets
.env

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
venv/
.venv/
build/
dist/
*.egg-info/
.coverage
htmlcov/

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.lof
*.lot
*.idx
*.ilg
*.ind
*.pdf
# Source documents deposited in docs/ are durable references, not rendered output
!docs/*.pdf
# P3→P4 boundary: report/inputs/generated/ is the analysis→writing handoff
# surface. Its figure PDFs are phase OUTCOMES the manuscript/slides include
# (policy: docs/pipeline-phases.md). The global *.pdf above still ignores
# report.pdf and LaTeX aux PDFs (those live elsewhere / are P4 finals).
!report/inputs/generated/*.pdf

# Generated slide data: ignore the directory CONTENTS (`/*`, not the
# directory itself) so the per-file negations below can re-include the
# tracked boundary outcomes. The trailing-slash form `slides/inputs/generated/`
# excludes the whole tree and makes negations dead — see docs/pipeline-phases.md.
slides/inputs/generated/*
# Slide P3→P4 boundary outcomes: the only slides/inputs/generated files
# `\input` by slides.tex (everything else there — fig_regimes_scatter.pdf,
# fig_scaling_curve.pdf, cost_quality.csv — has no P4 consumer = intermediate).
!slides/inputs/generated/macros.tex
!slides/inputs/generated/tab_exp2_2x2.tex

# Slide assets: handoff artifacts derived from tracked sources
!slides/inputs/logo-cired.pdf
!slides/inputs/QR-aedist.pdf

# Intermediate report-generated files — P3-internal, rebuilt by make, not
# handoff artifacts. The view CSVs are mart→view projections (P3).
# cost_quality.csv is deliberately NOT listed here: it is a P3→P4 boundary
# outcome — slides/Makefile lists report/inputs/generated/cost_quality.csv as a
# hard prerequisite of manuscript/main.pdf (a P4 write target), so by the
# producer-phase≠consumer-phase test it must be tracked. A clean checkout has
# no working-tree copy, so untracking it broke `make slides`/`make manuscript`
# and the clean-room tests. No global pattern matches .csv beyond these explicit
# lines, so omitting it is enough to track it. macros_p1_base.tex is likewise
# omitted: a P3→P4 boundary outcome (`\InputIfFileExists` by report.tex and
# slides.tex).
report/inputs/generated/census_bars.csv
report/inputs/generated/exp2_mart.jsonl
report/inputs/generated/exp2_turn_trajectory_view.csv
report/inputs/generated/sota_cross_eval_view.csv
report/inputs/generated/tab_exp2_arms_runs_view.csv
report/inputs/generated/tab_exp2_bib_quality_view.csv

# Sentinel for plot_method_convergence --output when only macros_census.tex
# is needed (the PDF co-output is the retired fig_census_direct, ticket 0361).
derived/_macros_census_unused.pdf

# Experiment working files (large intermediates, not needed for analysis)
experiments/data/rag_work/
experiments/jobs/

# Report input data
report/inputs/documents/*
report/inputs/feeds/*

# Attic (old manual experiments, legacy results)
attic/

# Migration backups
*.jsonl.bak-*

# Derived markdown artifacts from SOTA experiment runs (ticket 0291)
# These are extracted from raw JSON during post-processing, not primary data
experiments/outputs/sota_exp3_*/**/*.md
!experiments/outputs/sota_exp3_*/**/README.md
!experiments/outputs/sota_exp3_*/**/summary_*.md
# Exception: this one mistral.md is a tracked P1 raw-output sibling of its
# mistral.json (committed for provenance). Negation is scoped to the EXACT
# path — never a `*.md` glob — so no other extracted markdown is re-included.
!experiments/outputs/sota_exp3_arm3_batch1/archive/run02_rerun_mistral_20260525T0521_local/mistral.md

# Evaluation reconciliation artifacts (generated)
reconciliation_*.csv
**/reconciliation_*.csv

# Beat cycle runtime log
beat-log.jsonl

# Editor / IDE / OS
*~
*.swp
*.swo
.vscode/
.idea/
.DS_Store
Thumbs.db

# Figures (tracked selectively in report/Pictures/)
# *.png — removed, let git track what's committed
.claude/worktrees/
.claude/projects/
.claude/scheduled_tasks.lock


# git-erg compiled binary
tickets/tools/go/erg
.aider*

# Per-run scoring records under derived/ are regenerated by the scoring
# pipeline (rebuild-measurements); raw-output sidecars under
# experiments/outputs/ stay tracked (provenance, cf. exp1_batch2).
experiments/derived/*.record.json
experiments/derived/**/*.record.json
