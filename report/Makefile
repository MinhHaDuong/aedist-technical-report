# AEDIST Technical Report — LaTeX build
#
# Builds report.pdf from report.tex and generated tables.
# Tables are generated by `make -f experiments/render.mk report-tables`
# from the repo root.

GENERATED := inputs/generated

.PHONY: all clean cleaner

all: report.pdf

report.pdf: report.tex refs.bib $(wildcard $(GENERATED)/*.tex)
	tectonic $<

clean:
	rm -f *.log *.bbl *.blg *.run.xml report.synctex.gz

cleaner: clean
	rm -f report.pdf
